{
  "name": "open-voice-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "build": "npm run build:contracts && npm run build:catalog && npm run build:companion && npm run build:web",
    "test": "npm run test:contracts && npm run test:catalog",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "catalog:validate": "npm run validate --workspace @open-voice/catalog",
    "audit": "npm audit --audit-level=high",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "npm run dev --workspace @open-voice/web",
    "build:web": "npm run build --workspace @open-voice/web",
    "build:companion": "npm run build --workspace @open-voice/companion",
    "build:contracts": "npm run build --workspace @open-voice/contracts",
    "build:catalog": "npm run build --workspace @open-voice/catalog",
    "test:contracts": "npm run test --workspace @open-voice/contracts",
    "test:catalog": "npm run test --workspace @open-voice/catalog",
    "typecheck:contracts": "npm run typecheck --workspace @open-voice/contracts",
    "typecheck:catalog": "npm run typecheck --workspace @open-voice/catalog"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
