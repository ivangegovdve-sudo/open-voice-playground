{
  "name": "@open-voice/companion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "corpus:check": "node ./scripts/generate-protocol-corpus.mjs --check",
    "corpus:generate": "node ./scripts/generate-protocol-corpus.mjs --write",
    "openapi:check": "node ./scripts/generate-openapi.mjs --check",
    "openapi:generate": "node ./scripts/generate-openapi.mjs --write",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@hyperjump/json-schema": "1.17.7",
    "@tauri-apps/cli": "2.11.4",
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  }
}
