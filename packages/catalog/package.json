{
  "name": "@open-voice/catalog",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "audit:import": "tsx ./src/audit-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "tsx ./src/cli.ts ./fixtures/catalog.fixture.json"
  },
  "dependencies": {
    "@open-voice/contracts": "*",
    "zod": "4.4.3"
  }
}
