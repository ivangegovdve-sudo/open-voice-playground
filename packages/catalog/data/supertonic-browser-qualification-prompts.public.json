    {
      "rowId": "supertonic-q06-m1-el",
      "voiceId": "supertonic:M1",
      "language": "el",
      "promptText": "Το πρωινό φως γεμίζει τον ήσυχο κήπο και μικρά πουλιά αρχίζουν να τραγουδούν.",
